<script>
  // ============================================================
  // Populate every image/video/3D slot from assets-config.js.
  // Anything left "" in that file gets a clean placeholder here
  // instead of a broken image or a dead iframe.
  // ============================================================
  function initAssetsFromConfig() {
    if (typeof window.ASSETS === 'undefined') {
      console.warn('assets-config.js not loaded — using the defaults baked into the HTML.');
      return;
    }
    var A = window.ASSETS;
 
    // ---- Land: hero photo + 3D + video ----
    if (A.land.heroPhoto) document.getElementById('fc-img-15').src = A.land.heroPhoto;
 
    var has3D = !!A.land.model3D;
    var hasVid = !!A.land.videoTour;
    if (has3D) document.getElementById('fc-3d-15').setAttribute('data-src', A.land.model3D);
    if (hasVid) document.getElementById('fc-vid-15').src = A.land.videoTour;
 
    var btn3d = document.getElementById('btn-3d-15');
    var btnVid = document.getElementById('btn-vid-15');
    if (!has3D) { btn3d.classList.add('disabled'); btn3d.title = 'Coming soon'; }
    if (!hasVid) { btnVid.classList.add('disabled'); btnVid.title = 'Coming soon'; }
 
    // ---- Land: extra gallery photos (landSlot2 / landSlot3) ----
    registerLightboxSet('land', [A.land.heroPhoto, A.land.gallery2, A.land.gallery3].filter(Boolean));
    fillGallerySlot('landSlot2', A.land.gallery2, 1, 'Additional site photo');
    fillGallerySlot('landSlot3', A.land.gallery3, 2, 'Additional site photo');
 
    // ---- Build: floor plan + 4 renders ----
    var buildKeys = ['floorPlan','render1_exterior','render2_living','render3_bedroom','render4_kitchen'];
    var buildUrls = buildKeys.map(function(k){ return A.build[k]; });
    registerLightboxSet('build', buildUrls.filter(Boolean));
    for (var i = 0; i < buildKeys.length; i++) {
      var url = A.build[buildKeys[i]];
      var img = document.getElementById('buildImg' + i);
      if (url && img) img.src = url;
    }
 
    // ---- Agent photo/cover ----
    if (A.agent.headshot) {
      var h = document.querySelector('.agent-profile-img');
      if (h) h.src = A.agent.headshot;
    }
    if (A.agent.coverPhoto) {
      var c = document.querySelector('.agent-cover');
      if (c) c.style.backgroundImage = "url('" + A.agent.coverPhoto + "')";
    }
  }
 
  function fillGallerySlot(slotId, url, lightboxIndex, altText) {
    var slot = document.getElementById(slotId);
    if (!slot || !url) return; // leave the "coming soon" placeholder as-is
    slot.style.background = '';
    slot.style.cursor = 'pointer';
    slot.innerHTML = '<img src="' + url + '" alt="' + altText + '">' +
      '<div class="gg-overlay"><span><i class="fas fa-search-plus"></i> View</span></div>';
    slot.setAttribute('onclick', 'openLandGallery(' + lightboxIndex + ')');
  }
 
  // Wrap switchFeaturedMedia so a "coming soon" button shows a toast
  // instead of switching to an empty iframe.
  var _switchFeaturedMediaOriginal = switchFeaturedMedia;
  switchFeaturedMedia = function(type) {
    var btn = document.getElementById('btn-' + type + '-15');
    if (btn && btn.classList.contains('disabled')) {
      if (typeof showToastMsg === 'function') showToastMsg('Coming soon');
      return;
    }
    if (type === '3d') {
      var frame = document.getElementById('fc-3d-15');
      var real = frame.getAttribute('data-src');
      if (real && !frame.getAttribute('src')) frame.src = real;
    }
    _switchFeaturedMediaOriginal(type);
  };
 
  document.addEventListener('DOMContentLoaded', initAssetsFromConfig);
</script>
 
 
